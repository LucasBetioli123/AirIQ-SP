# LLM provider for the agent (RAG module). Options: llamacpp | ollama | openai_compat
LLM_PROVIDER=llamacpp
# llamacpp: GGUF path (downloaded by `make models`); ollama/openai_compat: model name
LLM_MODEL=models/llm/qwen3-4b-instruct-2507-q4_k_m.gguf
# ollama: http://localhost:11434/v1 ; Groq: https://api.groq.com/openai/v1 ;
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
LLM_API_KEY=
# Local embeddings / reranker (GGUF)
EMB_MODEL=models/emb/granite-embedding-multilingual-278m-f16.gguf
RERANK_MODEL=models/rerank/qwen3-reranker-0.6b.gguf
# Retrieval: bm25 | dense | hybrid | hybrid_rerank (default; the reranker reorders the top RAG_RERANK_TOP)
RAG_MODE=hybrid_rerank
RAG_RERANK_TOP=8
# refusal thresholds before generation (calibrated in reports/metrics/rag_limiar_recusa.csv)
RAG_RERANK_MIN=0.8
RAG_COS_MIN=0.675
# reference date for "today/tomorrow" in the PM2.5 tool (default: last day with data)
# AGENT_TODAY=2023-04-03
