# Provedor de LLM do agente (Parte 2). Opções: llamacpp | ollama | openai_compat
LLM_PROVIDER=llamacpp
# llamacpp: caminho do GGUF (baixado por `make models`); ollama/openai_compat: nome do modelo
LLM_MODEL=models/llm/qwen3-4b-instruct-2507-q4_k_m.gguf
# ollama: http://localhost:11434/v1 ; Groq: https://api.groq.com/openai/v1 ;
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
LLM_API_KEY=
# Embeddings / reranker locais (GGUF)
EMB_MODEL=models/emb/granite-embedding-multilingual-278m-f16.gguf
RERANK_MODEL=models/rerank/qwen3-reranker-0.6b.gguf
# Recuperação: bm25 | dense | hybrid | hybrid_rerank (padrão; reranker reordena os RAG_RERANK_TOP primeiros)
RAG_MODE=hybrid_rerank
RAG_RERANK_TOP=8
# limiares de recusa sem gerar (calibrados em reports/metrics/rag_limiar_recusa.csv)
RAG_RERANK_MIN=0.8
RAG_COS_MIN=0.675
# data de referência para "hoje/amanhã" na ferramenta de PM2.5 (padrão: último dia com dados)
# AGENT_TODAY=2023-04-03
